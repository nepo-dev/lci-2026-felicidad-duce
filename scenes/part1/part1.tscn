[node name="EscuelaMonjasText" parent="EscuelaMonjas" unique_id=1133325201 instance=ExtResource("10_mk7yd")]
z_index = 15
offset_left = 6580.0
offset_top = 39.0
offset_right = 7031.0
offset_bottom = 729.0
text = "A los 4 años fui acogida como estudiante en la [color=#C61A29][font=res://scenes/fonts/Fraunces_72pt-SemiBold.ttf]escuela de monjas de la Presentación.[/font][/color]"

[node name="EscuelaMonjasText2" parent="EscuelaMonjas" unique_id=717508414 instance=ExtResource("10_mk7yd")]
z_index = 15
offset_left = 7630.0
offset_top = 358.0
offset_right = 8304.0
offset_bottom = 701.0
text = "Mi estadía fue marcada por la [color=#C61A29][font=res://scenes/fonts/Fraunces_72pt-SemiBold.ttf]diferencia de beneficios[/font][/color] entre yo y las alumnas de pago."

[node name="EscuelaMonjasText3" parent="EscuelaMonjas" unique_id=641133777 instance=ExtResource("10_mk7yd")]
z_index = 15
offset_left = 8895.0
offset_top = 249.0
offset_right = 9663.0
offset_bottom = 592.0
text = "No dejé que eso me hundiese y me propuse [color=#C61A29][font=res://scenes/fonts/Fraunces_72pt-SemiBold.ttf]esforzarme en los estudios.[/font][/color]"

[node name="EscuelaMonjas2" type="Node" parent="." unique_id=334927508]

[node name="EscuelaMonjasText4" parent="EscuelaMonjas2" unique_id=100275373 instance=ExtResource("10_mk7yd")]
z_index = 15
offset_left = 12039.0
offset_top = 350.0
offset_right = 10849.0
offset_bottom = -650.0
text = "Mis esfuerzos dieron frutos y las monjas consideraron que tenía un talento privilegiado. Premiaron mis esfuerzos con beneficios a los que antes no tenía acceso, las [color=#C61A29][font=res://scenes/fonts/Fraunces_72pt-SemiBold.ttf]clases de pintura etc.[/font][/color]"

