offset_bottom = -32.0
text = "En un apartamento del barrio de [color=#C61A29][font=res://scenes/fonts/Fraunces_72pt-SemiBold.ttf]Grácia[/font][/color], mis padres [color=#C61A29][font=res://scenes/fonts/Fraunces_72pt-SemiBold.ttf]Elies Duce[/font][/color] y [color=#C61A29][font=res://scenes/fonts/Fraunces_72pt-SemiBold.ttf]Mercè Ripolles[/font][/color] me vieron dar mis primeros pasos.
"

