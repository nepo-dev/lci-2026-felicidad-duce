[node name="ParedCuadros" type="Node2D" parent="." unique_id=1142854656]
position = Vector2(0, 96)

[node name="ParedCuadrosText" parent="ParedCuadros" unique_id=1876953193 instance=ExtResource("10_mk7yd")]
z_index = 15
offset_left = 3443.0
offset_top = 168.0
offset_right = 3944.0
offset_bottom = 858.0
text = "Fui la [color=#C61A29][font=res://scenes/fonts/Fraunces_72pt-SemiBold.ttf]segunda de seis hermanos[/font][/color] [br]y, como buena hermana mayor, siempre me ocupé de cuidar de mis hermanos y ayudar en los labores del hogar."

[node name="Pared" type="Sprite2D" parent="ParedCuadros" unique_id=186456705]
